    "origin": "https://github.com/XIU2/Yuedu/blob/426b24f59aa763ee0f2d9cc094612d2ef42c8293/shuyuan",
    "document": {
      "version": 3,
      "kind": "novel",
      "encoding": "utf-8",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
        "Referer": "http://appi.kuwo.cn/"
      },
      "check_keyword": "三国",
      "operations": {
        "search": {
          "format": "json",
          "path": "/novels/api/book/search",
          "params": {
            "ps": "10"
          },
          "param_names": {
            "keyword": "keyword",
            "page": "pi"
          },
          "list": {
            "path": "data"
          },
          "fields": {
            "id": {
              "path": "book_id"
            },
            "title": {
              "path": "title"
            },
            "author": {
              "path": "author_name"
            },
            "cover": {
              "path": "cover_url"
            },
            "summary": {
              "path": "intro"
            },
            "url": {
              "path": "book_id",
              "regex": {
                "pattern": "^(.+)$",
                "replacement": "/novels/api/book/${1}"
              }
            },
            "genres": {
              "path": "category_name"
            }
          }
        },
        "detail": {
          "format": "json",
          "root": {
            "path": "data"
          },
          "fields": {
            "id": {
              "path": "book_id"
            },
            "title": {
              "path": "title"
            },
            "author": {
              "path": "author_name"
            },
            "cover": {
              "path": "cover_url"
            },
            "summary": {
              "path": "intro"
            },
            "toc_url": {
              "path": "book_id",
              "regex": {
                "pattern": "^(.+)$",
                "replacement": "/novels/api/book/${1}/chapters?paging=0"
              }
            }
          }
        },
        "toc": {
          "format": "json",
          "list": {
            "path": "data"
          },
          "fields": {
            "id": {
              "path": "chapter_id"
            },
            "title": {
              "path": "chapter_title"
            },
            "chapter_url": {
              "concat": [
                {
                  "path": "book_id",
                  "regex": {
                    "pattern": "^(.+)$",
                    "replacement": "/novels/api/book/${1}/chapters/"
                  }
                },
                {
                  "path": "chapter_id"
                }
              ]
            }
          }
        },
        "content": {
          "format": "json",
          "text": {
            "path": "data.content"
          }
        }
      }
    },
    "checkedAt": "2026-10-19",
    "status": "verified",
    "summary": "搜索、详情、目录、首章实测通过；只测免费章节。当前源 HTTP 可用，HTTPS 返回业务错误。",
