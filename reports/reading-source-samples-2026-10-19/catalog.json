            "author": {
              "query": ".v-author",
              "attr": "text"
            },
            "cover": {
              "query": "img",
              "attr": "src"
            },
            "summary": {
              "query": ".v-intro",
              "attr": "text"
            },
            "url": {
              "attr": "onclick",
              "regex": {
                "pattern": "^.*newWebView\\('([^']+)'.*$",
                "replacement": "${1}"
              }
            }
          }
        },
        "detail": {
          "format": "html",
          "fields": {
            "title": {
              "query": ".face-info-title",
              "attr": "text"
            },
            "author": {
              "query": ".face-info .v-words span",
              "attr": "text",
              "index": {
                "indices": [
                  0
                ]
              },
              "regex": {
                "pattern": "^作者：",
                "replacement": ""
              }
            },
            "cover": {
              "query": ".face-cover img",
              "attr": "src"
            },
            "summary": {
              "query": "#intro",
              "attr": "text"
            },
            "toc_url": {
              "query": ".sumchapter a",
              "attr": "href"
            }
          }
        },
        "toc": {
          "format": "html",
          "list": {
            "query": ".catalog_ls li a",
            "attr": "text"
          },
          "fields": {
            "title": {
              "attr": "text"
            },
            "chapter_url": {
              "attr": "href"
            }
          }
        },
        "content": {
          "format": "html",
          "text": {
            "concat": [
              {
                "query": ".con",
                "attr": "text",
                "regex": {
                  "pattern": "[（(]本章未完[^）)]*[）)]|[（(]本章完[）)]",
                  "replacement": ""
                }
              }
            ],
            "separator": "\n\n"
          }
        }
      }
    },
    "checkedAt": "2026-10-19",
    "status": "verified",
    "summary": "搜索、详情、779 章目录、首章全部 5 段实测通过；站点提示部分阅读需客户端，未测试付费章节。",
